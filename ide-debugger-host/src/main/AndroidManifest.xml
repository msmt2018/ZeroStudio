<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.itsaky.androidide.zerostudio.ide.debugger.host">

    <!--
        ide-debugger-host: 不需要任何权限, host 进程内运行, 通过 JDWP
        桥接到 IDE。它不申请 / 启动任何服务, 不读写公共存储, 也不访问
        网络。所有 IO 都通过 AbstractJDWPSocket (Android VM 内部抽象套接字)
        和 IDE 端的 LocalServerSocket (在 host 进程内) 完成。
    -->

    <application>
        <!--
            子项目 9c: HostAttachAgentBootstrap 是一个 ContentProvider,
            在 host app 启动时 (早于 Application.onCreate) 被 framework
            实例化, 触发反向连 IDE LocalServerSocket 的线程。

            Manifest placeholder (由 IdeDebuggerInitScriptPlugin 注入):
              - authorities: 用固定 authority (跟 ide-log-plugin 区分开)
              - meta-data ide_local_server_name: 注入 IDE LocalServerSocket 名字
        -->
        <provider
            android:name="com.itsaky.androidide.zerostudio.ide.debugger.host.HostAttachAgentBootstrap"
            android:authorities="com.zerostudio.host.attachagent"
            android:exported="false"
            android:initOrder="100">
            <meta-data
                android:name="ide_local_server_name"
                android:value="${ideLocalServerName}" />
        </provider>
    </application>
</manifest>

