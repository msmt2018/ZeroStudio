<?xml version="1.0" encoding="utf-8"?>
<!--
  ZeroStudio IDE - 断点类型单项 (Phase 20)
  含: 图标 + 标题 + 描述

  Phase 24 bug 修复:
    - 图标从 40dp 缩到 32dp, 避免在窄列里独占宽度
    - 文字列加 minWidth, 防止父容器 WRAP_CONTENT 时 weight=1 塌缩成 0 (只剩图标)
    - 外层加 minHeight=48dp 保证触摸目标
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_bp_type_item"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/bptpe_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:tint="#FFAB40"
        tools:src="@drawable/ic_bp_line"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="200dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bptpe_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="#F0FFFFFF"
            tools:text="普通行断点"/>

        <TextView
            android:id="@+id/bptpe_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#A0FFFFFF"
            tools:text="程序运行到这一行代码之前暂停"/>
    </LinearLayout>
</LinearLayout>
