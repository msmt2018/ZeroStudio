<?xml version="1.0" encoding="utf-8"?>
<!--
  通用 Git Compose 页面布局 (共享): mini-toolbar + ComposeView 占位.
  供协作子页面 (PR / Pipelines / CodeReview) 等只需要 mini-toolbar + Compose 的 fragment 复用.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <include layout="@layout/layout_git_mini_toolbar" />

    <FrameLayout
        android:id="@+id/git_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
