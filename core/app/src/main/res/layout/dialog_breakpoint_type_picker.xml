<?xml version="1.0" encoding="utf-8"?>
<!--
  ZeroStudio IDE - 断点类型选择器弹窗布局 (白底紧凑版)
  高斯模糊磨砂半透明效果 (白色版)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minWidth="320dp"
        android:maxWidth="640dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_frosted_glass"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debugger_bp_type_picker_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="#FF1E1E1E"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/bptp_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#99000000"
            android:fontFamily="monospace"
            tools:text="MainActivity.kt : 27"
            xmlns:tools="http://schemas.android.com/tools"/>

        <!-- 滚动列表 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxHeight="440dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/bptp_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@android:color/transparent"
                android:dividerPadding="4dp"
                android:showDividers="middle"/>
        </ScrollView>

        <!-- 取消按钮 -->
        <TextView
            android:id="@+id/bptp_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@android:string/cancel"
            android:textColor="#991E1E1E"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</FrameLayout>
