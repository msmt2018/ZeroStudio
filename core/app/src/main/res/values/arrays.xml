<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="search_file_masks">
        <item>ALL</item>
        <item>*.java</item>
        <item>*.kt</item>
        <item>*.xml</item>
        <item>*.gradle</item>
        <item>*.json</item>
        <item>*.c</item>
        <item>*.cpp</item>
        <item>*.h</item>
        <item>*.txt</item>
        <item>*.properties</item>
    </string-array>

    <!-- 断点条件对话框 (Phase E2) - 命中次数策略下拉 -->
    <string-array name="debugger_bcd_hit_count_modes">
        <item>始终触发</item>
        <item>命中次数 = N</item>
        <item>命中次数 > N</item>
        <item>每 N 次触发</item>
    </string-array>

    <!-- 断点条件对话框 - 常用日志消息模板 chip -->
    <string-array name="debugger_bcd_log_templates">
        <item>name = ${name}</item>
        <item>${name} = ${name}</item>
        <item>thread=${Thread.currentThread().getName()}</item>
        <item>elapsed=${System.nanoTime()}</item>
        <item>toString=${obj}</item>
    </string-array>
</resources>